{
  "name": "dsh-phone-bridge",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Local bridge that lets an iPhone drive DeepSeek Harness sessions over an end-to-end encrypted channel",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "bin": {
    "dsh-phone-doctor": "./bin/doctor.mjs",
    "dsh-phone-patch": "./bin/patch-dsh.mjs",
    "dsh-phone-pairing": "./bin/pairing.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "bin/",
    "cordis.patch.yml",
    "cordis.patch.example.yml",
    "install.ps1",
    "uninstall.ps1"
  ]
}
